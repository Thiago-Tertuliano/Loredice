{
  "expo": {
    "name": "LoreDice",
    "slug": "loredice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "loredice",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.axellion.loredice"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12101F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.axellion.loredice",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "O LoreDice precisa acessar sua galeria para adicionar fotos dos jogos."
        }
      ],
      "expo-font"
    ]
  }
}
